[
  { "start": 116.276, "end": 118.713, "text": "大家好" },
  { "start": 120.075, "end": 123.524, "text": "謝謝大家熱情的掌聲" },
  { "start": 123.87, "end": 129.174, "text": "今天好像也有配信和現場轉播" },
  { "start": 129.693, "end": 131.554, "text": "謝謝大家" },
  { "start": 131.792, "end": 136.83, "text": "啊 在劇場的大家\n還有觀看配信和現場轉播的乖孩子們" },
  { "start": 136.855, "end": 140.063, "text": "我是一年丙班的土井半助" },
  { "start": 140.923, "end": 142.814, "text": "謝謝大家" },
  { "start": 143.04, "end": 144.814, "text": "大家一定在想這是在做什麼吧" },
  { "start": 144.814, "end": 148.15, "text": "請慢慢入座喔\n我稍微提早出來了" },
  { "start": 148.337, "end": 153.52, "text": "想說在開演前\n先來跟大家說明一下注意事項" },
  { "start": 153.52, "end": 154.542, "text": "沒錯" },
  { "start": 154.908, "end": 158.423, "text": "音樂劇「忍たま乱太郎」第16彈" },
  { "start": 158.74, "end": 164.81, "text": "「作法委員會大顯身手！\n消失的下級生與嚴格的隨堂測驗之卷」" },
  { "start": 165.23, "end": 167.33, "text": "馬上就要開演了" },
  { "start": 168.04, "end": 170.19, "text": "那麼就來向大家說明" },
  { "start": 170.19, "end": 171.86, "text": "演出中的注意事項" },
  { "start": 172.5, "end": 174.56, "text": "首先是關於拍照" },
  { "start": 174.56, "end": 178.61, "text": "以及錄音、錄影等行為\n是完全禁止的" },
  { "start": 179.31, "end": 182.25, "text": "請大家一定要遵守喔" },
  { "start": 182.97, "end": 187.32, "text": "接著，在演出中請將智慧型手機" },
  { "start": 187.32, "end": 189.92, "text": "或會發出聲音、光線的電子設備" },
  { "start": 189.92, "end": 191.56, "text": "設定為關機" },
  { "start": 191.95, "end": 194.25, "text": "或者是靜音模式" },
  { "start": 195.03, "end": 196.79, "text": "請大家多多配合" },
  { "start": 197.87, "end": 201.55, "text": "還有，在劇場內的飲食" },
  { "start": 201.55, "end": 204.62, "text": "除了大廳之外，觀眾席是禁止飲食的" },
  { "start": 204.62, "end": 207.39, "text": "不過如果有蓋緊瓶蓋的飲料" },
  { "start": 207.39, "end": 210.15, "text": "在開演前是可以喝的" },
  { "start": 210.6, "end": 213.23, "text": "請在開演前飲用完畢喔" },
  { "start": 213.9, "end": 217.15, "text": "最後，關於應援手燈" },
  { "start": 217.15, "end": 220.89, "text": "在正片演出的時候是不能使用的" },
  { "start": 221.15, "end": 223.46, "text": "請大家先放在包包裡" },
  { "start": 224.2, "end": 226.75, "text": "等到第二部分的特別舞台秀時" },
  { "start": 226.75, "end": 229.04, "text": "就可以拿出來一起嗨囉" },
  { "start": 229.62, "end": 232.06, "text": "到時候請盡情揮舞吧" },
  { "start": 232.88, "end": 235.39, "text": "以上就是注意事項的說明" },
  { "start": 235.94, "end": 238.12, "text": "大家都記住了嗎？" },
  { "start": 239.31, "end": 242.06, "text": "謝謝大家的配合" },
  { "start": 242.75, "end": 247.12, "text": "那麼，距離開演還有稍微一點時間" },
  { "start": 247.12, "end": 250.31, "text": "請大家在座位上放鬆心情" },
  { "start": 250.31, "end": 251.86, "text": "慢慢期待開演吧" },
  { "start": 252.75, "end": 254.91, "text": "等一下見囉！" },
  { "start": 340.25, "end": 365.34, "text": "不 好像不是要出門的樣子" },
  { "start": 356.823, "end": 364.121, "text": "考量到近年的各種情況\n作為超級特別例外 是可以的" }
]
